# ─────────────────────────────────────────────
# Time Tracker Bot — Environment Variables
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────

# From @BotFather on Telegram. Format: NUMBERS:LETTERS
TELEGRAM_TOKEN=

# From console.groq.com/keys — starts with gsk_
GROQ_API_KEY=

# From the Notion "Time Tracker Bot" integration — starts with ntn_
NOTION_API_KEY=

# Your Time Log database ID
NOTION_DATABASE_ID=

# Message your bot, then open:
# https://api.telegram.org/bot<YOUR_TELEGRAM_TOKEN>/getUpdates
# Look for "chat":{"id":XXXXXXXXX}
TELEGRAM_CHAT_ID=

# ── Optional (defaults shown) ────────────────
# Critical on Railway: the container runs in UTC.
TIMEZONE=Asia/Kolkata
SUMMARY_HOUR=22
SUMMARY_MINUTE=0
