"""
Time Tracker Bot
─────────────────────────────────────────────
A Telegram bot that captures your daily activities via voice or text,
uses Groq (Whisper + Open AI) to transcribe and parse them,
and logs everything to a Notion database for analysis.

Sends an automated daily summary at 10 PM.
"""

import os
import json
import logging
from datetime import datetime
from dotenv import load_dotenv
from telegram import Update
from telegram.ext import Application, MessageHandler, filters, ContextTypes
from groq import Groq
from notion_client import Client as NotionClient
from apscheduler.schedulers.asyncio import AsyncIOScheduler

# Load environment variables from .env file
load_dotenv()

# Set up logging so you can see what's happening
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)

# Initialise clients — just Groq and Notion
groq_client = Groq(api_key=os.getenv("GROQ_API_KEY"))
notion = NotionClient(auth=os.getenv("NOTION_API_KEY"))
NOTION_DATABASE_ID = os.getenv("NOTION_DATABASE_ID")


# ─────────────────────────────────────────────
# STEP 1: Transcribe voice note using Groq Whisper
# ─────────────────────────────────────────────
async def transcribe_voice(file_path: str) -> str:
    """
    Sends audio file to Groq's hosted Whisper model.
    Returns the transcribed text.
    """
    with open(file_path, "rb") as audio_file:
        transcript = groq_client.audio.transcriptions.create(
            file=(file_path, audio_file.read()),
            model="whisper-large-v3-turbo"
        )
    return transcript.text


# ─────────────────────────────────────────────
# STEP 2: Parse intent using Groq (Open AI model)
# ─────────────────────────────────────────────
def parse_activity(text: str, timestamp: str) -> dict:
    """
    Sends transcribed text to Groq's Open AI model.
    Extracts event type (START/END), activity, and category.
    Returns a structured dictionary.
    """
    completion = groq_client.chat.completions.create(
        model="openai/gpt-oss-20b",
        messages=[{
            "role": "user",
            "content": f"""You are a time tracking assistant.
Parse this message and return ONLY a JSON object with no extra text, no markdown formatting.

Message: "{text}"
Timestamp: {timestamp}

Return this exact JSON structure:
{{
  "event_type": "START or END",
  "activity": "short activity name (max 4 words)",
  "category": "one of: Deep Work, Routine, Meals, Fitness, Leisure, Sleep, Doom Scrolling, Travel, Social",
  "timestamp": "{timestamp}"
}}

Examples:
- "going to take a bath" -> START, Morning Hygiene, Routine
- "done with bath" -> END, Morning Hygiene, Routine
- "starting sprint planning" -> START, Sprint Planning, Deep Work
- "watching youtube" -> START, YouTube, Doom Scrolling"""
        }],
        temperature=0.2,
        response_format={"type": "json_object"}
    )

    response_text = completion.choices[0].message.content.strip()
    return json.loads(response_text)


# ─────────────────────────────────────────────
# STEP 3: Log entry to Notion database
# ─────────────────────────────────────────────
def log_to_notion(parsed: dict, raw_text: str):
    """
    Writes a new row to your Notion time tracking database.
    """
    notion.pages.create(
        parent={"database_id": NOTION_DATABASE_ID},
        properties={
            "Activity": {
                "title": [{"text": {"content": parsed["activity"]}}]
            },
            "Event Type": {
                "select": {"name": parsed["event_type"]}
            },
            "Category": {
                "select": {"name": parsed["category"]}
            },
            "Timestamp": {
                "date": {"start": parsed["timestamp"]}
            },
            "Raw Input": {
                "rich_text": [{"text": {"content": raw_text}}]
            }
        }
    )


# ─────────────────────────────────────────────
# STEP 4: Handle incoming Telegram messages
# ─────────────────────────────────────────────
async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """
    Runs every time you send a message to your bot.
    Handles both text and voice notes.
    """
    timestamp = datetime.now().isoformat()
    raw_text = ""

    if update.message.voice:
        # Voice message — download and transcribe
        await update.message.reply_text("Got it, processing...")

        voice_file = await context.bot.get_file(update.message.voice.file_id)
        file_path = f"/tmp/voice_{update.message.message_id}.ogg"
        await voice_file.download_to_drive(file_path)

        raw_text = await transcribe_voice(file_path)
        os.remove(file_path)

    elif update.message.text:
        raw_text = update.message.text

    if not raw_text:
        return

    try:
        parsed = parse_activity(raw_text, timestamp)
        log_to_notion(parsed, raw_text)

        await update.message.reply_text(
            f"✅ Logged\n"
            f"📌 {parsed['event_type']}: {parsed['activity']}\n"
            f"🏷️ {parsed['category']}\n"
            f"🕐 {parsed['timestamp'][:16].replace('T', ' ')}"
        )
    except Exception as e:
        logger.error(f"Error processing message: {e}")
        await update.message.reply_text(f"⚠️ Something went wrong: {str(e)[:100]}")


# ─────────────────────────────────────────────
# STEP 5: Nightly summary at 10 PM
# ─────────────────────────────────────────────
async def send_nightly_summary(app):
    """
    Runs automatically at 10 PM every day.
    Analyses today's entries and sends insights to your Telegram.
    """
    today = datetime.now().date().isoformat()

    results = notion.databases.query(
        database_id=NOTION_DATABASE_ID,
        filter={
            "property": "Timestamp",
            "date": {"on_or_after": f"{today}T00:00:00"}
        }
    )

    if not results["results"]:
        return

    entries = []
    for page in results["results"]:
        props = page["properties"]
        activity = props["Activity"]["title"][0]["text"]["content"]
        event_type = props["Event Type"]["select"]["name"]
        category = props["Category"]["select"]["name"]
        timestamp = props["Timestamp"]["date"]["start"][:16].replace("T", " ")
        entries.append(f"{timestamp} | {event_type} | {activity} | {category}")

    entries_text = "\n".join(entries)

    completion = groq_client.chat.completions.create(
        model="openai/gpt-oss-20b",
        messages=[{
            "role": "user",
            "content": f"""Analyse this person's day and give honest, direct insights.

Today's time log:
{entries_text}

Provide:
1. Total time per category (calculate from START/END pairs)
2. Biggest time blocks
3. Unaccounted gaps (large gaps between entries)
4. Honest assessment: was this a productive day?
5. One specific suggestion for tomorrow

Be direct and concise. No fluff."""
        }],
        temperature=0.3
    )

    summary = completion.choices[0].message.content

    chat_id = os.getenv("TELEGRAM_CHAT_ID")
    await app.bot.send_message(
        chat_id=chat_id,
        text=f"📊 *Daily Summary*\n\n{summary}",
        parse_mode="Markdown"
    )


# ─────────────────────────────────────────────
# MAIN — Start the bot
# ─────────────────────────────────────────────
def main():
    app = Application.builder().token(os.getenv("TELEGRAM_TOKEN")).build()

    # Register message handler for text and voice
    app.add_handler(MessageHandler(filters.TEXT | filters.VOICE, handle_message))

    # Schedule nightly summary at 10 PM
    scheduler = AsyncIOScheduler()
    scheduler.add_job(
        send_nightly_summary,
        trigger="cron",
        hour=22,
        minute=0,
        args=[app]
    )
    scheduler.start()

    logger.info("Bot is running...")
    app.run_polling()


if __name__ == "__main__":
    main()
